#include <iostream>
#include <iomanip>
using namespace std;

class Item
{
protected:
    int item_no;
    string name;
    float price;

public:
    void getItem()
    {
        cout << "Enter Item Number: ";
        cin >> item_no;

        cout << "Enter Item Name: ";
        cin >> name;

        cout << "Enter Price: ";
        cin >> price;
    }
};

class DiscountedItem : public Item
{
private:
    float discount_percent;
    float discount_amount;
    float final_price;

public:
    void getDiscount()
    {
        cout << "Enter Discount Percentage: ";
        cin >> discount_percent;

        discount_amount = price * discount_percent / 100;
        final_price = price - discount_amount;
    }

    void display()
    {
        cout << left << setw(10) << item_no
             << setw(15) << name
             << setw(12) << price
             << setw(12) << discount_percent
             << setw(15) << final_price << endl;
    }

    float getFinalPrice()
    {
        return final_price;
    }
};

int main()
{
    DiscountedItem item[20];
    int n;
    float total = 0;

    cout << "Enter number of items: ";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cout << "\nEnter details of Item " << i + 1 << endl;

        item[i].getItem();
        item[i].getDiscount();

        total += item[i].getFinalPrice();
    }

    cout << "\n================ ITEM BILL ================\n";

    cout << left << setw(10) << "Item No"
         << setw(15) << "Name"
         << setw(12) << "Price"
         << setw(12) << "Discount"
         << setw(15) << "Final Price" << endl;

    cout << "-------------------------------------------------------------\n";

    for (int i = 0; i < n; i++)
    {
        item[i].display();
    }

    cout << "-------------------------------------------------------------\n";
    cout << "Total Amount = " << total << endl;

    return 0;
}
