#include <iostream>
#include <string>
using namespace std;

class String
{
    string str;

public:
    String(string s = "")
    {
        str = s;
    }

    // == operator
    bool operator==(String s)
    {
        return str == s.str;
    }

    // > operator
    bool operator>(String s)
    {
        return str > s.str;
    }

    // < operator
    bool operator<(String s)
    {
        return str < s.str;
    }
};

int main()
{
    string s1, s2;

    cout << "Enter first string: ";
    getline(cin, s1);

    cout << "Enter second string: ";
    getline(cin, s2);

    String a(s1), b(s2);

    if (a == b)
        cout << "Both strings are equal." << endl;
    else if (a > b)
        cout << "First string is greater than second string." << endl;
    else if (a < b)
        cout << "First string is smaller than second string." << endl;

    return 0;
}
