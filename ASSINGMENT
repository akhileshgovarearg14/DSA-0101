const int MAX_CITIZENS   = 100;
const int MAX_COMPLAINTS = 200;
const int MAX_TEAMS      = 10;
 
/* =====================================================================================
 *  CLASS : Citizen
 *  Represents a registered citizen who can file civic complaints.
 * ===================================================================================== */
class Citizen {
private:
    int    citizenId;
    string name;
    string contactNumber;
    string address;
    bool   isRegistered;          // guards default (placeholder) objects
 
    static int totalCitizens;     // static member -> shared across all objects
 
public:
    // ---- Default constructor ----
    Citizen() : citizenId(0), name("N/A"), contactNumber("N/A"),
                address("N/A"), isRegistered(false) {}
 
    // ---- Parameterized constructor ----
    Citizen(int id, const string &n, const string &contact, const string &addr)
        : citizenId(id), name(n), contactNumber(contact), address(addr),
          isRegistered(true) {
        totalCitizens++;
    }
 
    // ---- Copy constructor ----
    Citizen(const Citizen &c)
        : citizenId(c.citizenId), name(c.name), contactNumber(c.contactNumber),
          address(c.address), isRegistered(c.isRegistered) {
        // A copy represents a duplicate record (e.g., for backup/report), not
        // a brand-new citizen, so the shared counter is intentionally left untouched.
    }
 
    // ---- Copy assignment operator (rule of three) ----
    Citizen& operator=(const Citizen &c) {
        if (this == &c) return *this;
        citizenId     = c.citizenId;
        name          = c.name;
        contactNumber = c.contactNumber;
        address       = c.address;
        isRegistered  = c.isRegistered;
        return *this;
    }
 
    // ---- Destructor ----
    ~Citizen() { /* no dynamic resources owned directly by Citizen */ }
 
    int    getId()      const { return citizenId; }
    string getName()    const { return name; }
    bool   registered() const { return isRegistered; }
 
    void display() const {
        if (!isRegistered) return;
        cout << left << setw(6) << citizenId << setw(20) << name
             << setw(16) << contactNumber << setw(20) << address << endl;
    }
 
    static int getTotalCitizens() { return totalCitizens; }
};
int Citizen::totalCitizens = 0;
 
/* =====================================================================================
 *  CLASS : Complaint
 *  Represents a single civic complaint filed by a citizen.
 * ===================================================================================== */
class Complaint {
private:
    int    complaintId;
    int    citizenId;
    string type;             // e.g. Pothole, Streetlight, Garbage, Water Leakage, Public Safety
    string description;
    int    urgencyLevel;     // 1 (low) .. 5 (critical)
    string status;           // Pending / Assigned / In Progress / Resolved
    double priorityScore;
    string assignedTeam;
    string *internalNotes;   // dynamically allocated -> released in destructor
    bool    isRegistered;
 
    static int totalComplaints;   // total complaints ever filed
    static int activeComplaints;  // complaints not yet resolved
 
public:
    // ---- Default constructor ----
    Complaint()
        : complaintId(0), citizenId(0), type("N/A"), description("N/A"),
          urgencyLevel(0), status("N/A"), priorityScore(0.0),
          assignedTeam("Unassigned"), internalNotes(nullptr), isRegistered(false) {}
 
    // ---- Parameterized constructor ----
    Complaint(int id, int citId, const string &t, const string &desc, int urgency)
        : complaintId(id), citizenId(citId), type(t), description(desc),
          urgencyLevel(urgency), status("Pending"), priorityScore(0.0),
          assignedTeam("Unassigned"), isRegistered(true) {
        internalNotes = new string("Complaint logged and awaiting classification.");
        totalComplaints++;
        activeComplaints++;
    }
 
    // ---- Copy constructor (deep copy of dynamic member) ----
    Complaint(const Complaint &c)
        : complaintId(c.complaintId), citizenId(c.citizenId), type(c.type),
          description(c.description), urgencyLevel(c.urgencyLevel), status(c.status),
          priorityScore(c.priorityScore), assignedTeam(c.assignedTeam),
          isRegistered(c.isRegistered) {
        internalNotes = c.internalNotes ? new string(*c.internalNotes) : nullptr;
        // Backup copy - does not affect the shared totals.
    }
 
    // ---- Copy assignment operator (rule of three -> deep copy of dynamic member) ----
    Complaint& operator=(const Complaint &c) {
        if (this == &c) return *this;
        delete internalNotes;                 // release old resource first
        complaintId   = c.complaintId;
        citizenId     = c.citizenId;
        type          = c.type;
        description   = c.description;
        urgencyLevel  = c.urgencyLevel;
        status        = c.status;
        priorityScore = c.priorityScore;
        assignedTeam  = c.assignedTeam;
        isRegistered  = c.isRegistered;
        internalNotes = c.internalNotes ? new string(*c.internalNotes) : nullptr;
        return *this;
    }
 
    // ---- Destructor : releases dynamically allocated resource ----
    ~Complaint() {
        delete internalNotes;
        internalNotes = nullptr;
    }
 
    // ----- Accessors -----
    int    getId()          const { return complaintId; }
    int    getCitizenId()   const { return citizenId; }
    string getType()        const { return type; }
    string getStatus()      const { return status; }
    double getPriority()    const { return priorityScore; }
    string getAssignedTeam()const { return assignedTeam; }
    bool   registered()     const { return isRegistered; }
 
    // ----- Behaviour -----
    static double categoryWeight(const string &t) {
        if (t == "Public Safety")   return 5.0;
        if (t == "Water Leakage")   return 4.0;
        if (t == "Electrical")      return 4.0;
        if (t == "Pothole")         return 3.0;
        if (t == "Garbage")         return 2.0;
        return 1.0; // generic civic issue
    }
 
    void evaluatePriority() {
        // Priority formula: urgency dominates, category weight fine-tunes it.
        priorityScore = (urgencyLevel * 10.0) + (categoryWeight(type) * 5.0);
    }
 
    void assignTeam(const string &teamName) {
        assignedTeam = teamName;
        if (status == "Pending") status = "Assigned";
        if (internalNotes) *internalNotes += " Assigned to " + teamName + ".";
    }
 
    void updateStatus(const string &newStatus) {
        if (status == "Resolved") {
            cout << "  [Info] Complaint #" << complaintId << " is already resolved.\n";
            return;
        }
        status = newStatus;
        if (newStatus == "Resolved") {
            activeComplaints--; // one less active complaint
            if (internalNotes) *internalNotes += " Marked as RESOLVED.";
        }
    }
 
    // ---- Operator overload #1 : compare priority (used to rank urgency) ----
    bool operator>(const Complaint &other) const {
        return this->priorityScore > other.priorityScore;
    }
    bool operator<(const Complaint &other) const {
        return this->priorityScore < other.priorityScore;
    }
 
    // ---- Operator overload (bonus) : stream insertion for clean report formatting ----
    friend ostream& operator<<(ostream &out, const Complaint &c) {
        out << left << setw(5) << c.complaintId << setw(16) << c.type
            << setw(6) << c.urgencyLevel << setw(10) << fixed << setprecision(1)
            << c.priorityScore << setw(12) << c.status << c.assignedTeam;
        return out;
    }
 
    static int getTotalComplaints()  { return totalComplaints; }
    static int getActiveComplaints() { return activeComplaints; }
};
int Complaint::totalComplaints  = 0;
int Complaint::activeComplaints = 0;
 
/* =====================================================================================
 *  VIRTUAL-BASE-CLASS DEMONSTRATION (diamond inheritance)
 *  StaffMember  --> FieldOfficer   --\
 *               \-> AdminOfficer   ---> TeamSupervisor
 *  Without 'virtual' inheritance, TeamSupervisor would inherit two copies of
 *  StaffMember, causing ambiguity. 'virtual' ensures a single shared sub-object.
 * ===================================================================================== */
class StaffMember {
protected:
    int    staffId;
    string staffName;
public:
    StaffMember() : staffId(0), staffName("Unassigned") {}
    StaffMember(int id, const string &n) : staffId(id), staffName(n) {}
    virtual ~StaffMember() {}
    string getStaffName() const { return staffName; }
};
 
// Single inheritance
class FieldOfficer : virtual public StaffMember {
public:
    FieldOfficer() {}
    FieldOfficer(int id, const string &n) : StaffMember(id, n) {}
    void coordinateFieldWork() const {
        cout << "    Field coordination handled by " << staffName << endl;
    }
};
 
// Single inheritance
class AdminOfficer : virtual public StaffMember {
public:
    AdminOfficer() {}
    AdminOfficer(int id, const string &n) : StaffMember(id, n) {}
    void handleAdministration() const {
        cout << "    Administrative reporting handled by " << staffName << endl;
    }
};
 
// Multiple inheritance forming a diamond -> resolved via virtual base above
class TeamSupervisor : public FieldOfficer, public AdminOfficer {
public:
    TeamSupervisor() {}
    TeamSupervisor(int id, const string &n) : StaffMember(id, n),
                                               FieldOfficer(id, n),
                                               AdminOfficer(id, n) {}
    void superviseTeam() const {
        cout << "  Supervisor " << staffName << " (ID " << staffId << ") duties:\n";
        coordinateFieldWork();
        handleAdministration();
    }
};
 
/* =====================================================================================
 *  ABSTRACT BASE CLASS : ResponseTeam
 *  Defines common behaviour for every municipal response team.
 *  Hierarchical inheritance: several concrete team types derive from this one base.
 * ===================================================================================== */
class ResponseTeam {
protected:
    string teamName;
    int    capacity;         // maximum complaints the team can handle at once
    int    currentWorkload;  // complaints currently assigned
    TeamSupervisor supervisor;
 
    static int totalTeams;
 
public:
    ResponseTeam(const string &name, int cap, int supervisorId, const string &supervisorName)
        : teamName(name), capacity(cap), currentWorkload(0),
          supervisor(supervisorId, supervisorName) {
        totalTeams++;
    }
 
    virtual ~ResponseTeam() {}
 
    // Pure virtual functions -> make ResponseTeam an abstract class
    virtual string getTeamType() const = 0;
    virtual void   assignComplaint(Complaint &c) = 0;
 
    // Common (non-pure) virtual function -> can still be overridden if needed
    virtual void displayTeamInfo() const {
        double util = capacity > 0 ? (currentWorkload * 100.0 / capacity) : 0.0;
        cout << left << setw(22) << teamName << setw(19) << getTeamType()
             << setw(12) << currentWorkload << setw(12) << capacity
             << fixed << setprecision(1) << util << "%" << endl;
    }
 
    string getTeamName() const { return teamName; }
    int    getWorkload()  const { return currentWorkload; }
    int    getCapacity()  const { return capacity; }
 
    void showSupervisor() const { supervisor.superviseTeam(); }
 
    // ---- Operator overload #2 : combine workload/capacity of two teams ----
    // Returns the combined utilisation percentage of 'this' team and 'other',
    // useful for a joint civic-response workload report.
    double operator+(const ResponseTeam &other) const {
        int combinedLoad = this->currentWorkload + other.currentWorkload;
        int combinedCap  = this->capacity + other.capacity;
        return combinedCap > 0 ? (combinedLoad * 100.0 / combinedCap) : 0.0;
    }
 
    static int getTotalTeams() { return totalTeams; }
};
int ResponseTeam::totalTeams = 0;
 
/* ---------- Concrete municipal team types (hierarchical inheritance) ---------- */
 
class SanitationTeam : public ResponseTeam {
public:
    SanitationTeam(const string &name, int cap, int sid, const string &sname)
        : ResponseTeam(name, cap, sid, sname) {}
    string getTeamType() const override { return "Sanitation"; }
    void assignComplaint(Complaint &c) override {
        if (currentWorkload < capacity) { currentWorkload++; c.assignTeam(teamName); }
        else cout << "  [Warning] " << teamName << " is at full capacity.\n";
    }
};
 
