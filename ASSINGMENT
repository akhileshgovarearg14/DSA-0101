/* =====================================================================================
 *  CLASS : CivicComplaintSystem
 *  Manager / driver class holding arrays of objects and coordinating the workflow.
 * ===================================================================================== */
class CivicComplaintSystem {
private:
    Citizen   citizens[MAX_CITIZENS];
    int       citizenCount;
 
    Complaint complaints[MAX_COMPLAINTS];
    int       complaintCount;
 
    ResponseTeam* teams[MAX_TEAMS];   // base-class pointers -> runtime polymorphism
    int       teamCount;
 
public:
    CivicComplaintSystem() : citizenCount(0), complaintCount(0), teamCount(0) {}
 
    ~CivicComplaintSystem() {
        for (int i = 0; i < teamCount; i++) delete teams[i]; // release heap teams
    }
 
    void addTeam(ResponseTeam *team) {
        if (teamCount < MAX_TEAMS) teams[teamCount++] = team;
    }
 
    void registerCitizen(const string &name, const string &contact, const string &address) {
        if (citizenCount >= MAX_CITIZENS) { cout << "Citizen registry full.\n"; return; }
        int newId = citizenCount + 1;
        citizens[citizenCount++] = Citizen(newId, name, contact, address);
        cout << "  -> Citizen registered with ID " << newId << endl;
    }
 
    void registerComplaint(int citizenId, const string &type, const string &desc, int urgency) {
        if (complaintCount >= MAX_COMPLAINTS) { cout << "Complaint registry full.\n"; return; }
        if (findCitizenIndex(citizenId) == -1) {
            cout << "  [Error] No citizen found with ID " << citizenId << endl;
            return;
        }
        if (urgency < 1 || urgency > 5) {
            cout << "  [Error] Urgency level must be between 1 and 5.\n";
            return;
        }
        int newId = complaintCount + 1;
        Complaint c(newId, citizenId, type, desc, urgency);
        c.evaluatePriority();
        complaints[complaintCount++] = c;
        cout << "  -> Complaint #" << newId << " registered. Priority score = "
             << fixed << setprecision(1) << complaints[complaintCount - 1].getPriority() << endl;
        autoAssignTeam(complaints[complaintCount - 1].getId());
    }
 
    void autoAssignTeam(int complaintId) {
        int idx = findComplaintIndex(complaintId);
        if (idx == -1) return;
        string type = complaints[idx].getType();
        for (int i = 0; i < teamCount; i++) {
            if (teams[i]->getTeamType() == mapTypeToTeam(type)) {
                teams[i]->assignComplaint(complaints[idx]);   // virtual dispatch
                cout << "  -> Assigned to " << teams[i]->getTeamName()
                     << " (" << teams[i]->getTeamType() << ")" << endl;
                return;
            }
        }
        cout << "  [Warning] No matching team available for type: " << type << endl;
    }
 
    static string mapTypeToTeam(const string &type) {
        if (type == "Garbage")        return "Sanitation";
        if (type == "Pothole")        return "Road Maintenance";
        if (type == "Electrical")     return "Electrical";
        if (type == "Water Leakage")  return "Water Services";
        if (type == "Public Safety")  return "Public Safety";
        return "Sanitation"; // default catch-all
    }
 
    void updateComplaintStatus(int complaintId, const string &newStatus) {
        int idx = findComplaintIndex(complaintId);
        if (idx == -1) { cout << "  [Error] Complaint not found.\n"; return; }
        complaints[idx].updateStatus(newStatus);
        cout << "  -> Complaint #" << complaintId << " status updated to " << newStatus << endl;
    }
 
    void compareComplaints(int id1, int id2) const {
        int i1 = findComplaintIndex(id1);
        int i2 = findComplaintIndex(id2);
        if (i1 == -1 || i2 == -1) { cout << "  [Error] One or both complaints not found.\n"; return; }
        const Complaint &a = complaints[i1];
        const Complaint &b = complaints[i2];
        cout << "  Complaint #" << id1 << " priority = " << a.getPriority()
             << " | Complaint #" << id2 << " priority = " << b.getPriority() << endl;
        if (a > b)       cout << "  => Complaint #" << id1 << " is MORE urgent (operator> ).\n";
        else if (b > a)  cout << "  => Complaint #" << id2 << " is MORE urgent (operator> ).\n";
        else             cout << "  => Both complaints have EQUAL priority.\n";
    }
 
    void showTeamWorkload() const {
        cout << left << setw(22) << "Team" << setw(19) << "Type" << setw(12) << "Load"
             << setw(12) << "Capacity" << "Utilisation\n";
        cout << string(77, '-') << endl;
        for (int i = 0; i < teamCount; i++) {
            teams[i]->displayTeamInfo();   // runtime polymorphism via base pointer
        }
        if (teamCount >= 2) {
            double combined = (*teams[0]) + (*teams[1]);   // operator+ demonstration
            cout << "\n  Combined utilisation of " << teams[0]->getTeamName()
                 << " + " << teams[1]->getTeamName() << " = "
                 << fixed << setprecision(1) << combined << "%\n";
        }
    }
 
    void generateReport() const {
        cout << "\n================= CIVIC RESPONSE REPORT =================\n";
        cout << "Total Registered Citizens : " << Citizen::getTotalCitizens() << endl;
        cout << "Total Complaints Filed    : " << Complaint::getTotalComplaints() << endl;
        cout << "Active (Unresolved)       : " << Complaint::getActiveComplaints() << endl;
        cout << "Total Response Teams      : " << ResponseTeam::getTotalTeams() << endl;
        cout << "-----------------------------------------------------------\n";
        cout << left << setw(5) << "ID" << setw(16) << "Type" << setw(6) << "Urg"
             << setw(10) << "Priority" << setw(12) << "Status" << "Team" << endl;
        for (int i = 0; i < complaintCount; i++) {
            cout << complaints[i] << endl;   // operator<< demonstration
        }
        cout << "===========================================================\n";
    }
 
    void displayAllCitizens() const {
        cout << left << setw(6) << "ID" << setw(20) << "Name" << setw(16)
             << "Contact" << setw(20) << "Address" << endl;
        for (int i = 0; i < citizenCount; i++) citizens[i].display();
    }
 
    void displayAllComplaints() const {
        cout << left << setw(5) << "ID" << setw(16) << "Type" << setw(6) << "Urg"
             << setw(10) << "Priority" << setw(12) << "Status" << "Team" << endl;
        for (int i = 0; i < complaintCount; i++) cout << complaints[i] << endl;
    }
 
    void showSupervisors() const {
        for (int i = 0; i < teamCount; i++) {
            cout << teams[i]->getTeamName() << ":\n";
            teams[i]->showSupervisor();
        }
    }
 
private:
    int findCitizenIndex(int id) const {
        for (int i = 0; i < citizenCount; i++)
            if (citizens[i].getId() == id) return i;
        return -1;
    }
    int findComplaintIndex(int id) const {
        for (int i = 0; i < complaintCount; i++)
            if (complaints[i].getId() == id) return i;
        return -1;
    }
};
 
/* =====================================================================================
 *  MENU-DRIVEN DRIVER
 * ===================================================================================== */
void printMenu() {
    cout << "\n============ SMART CIVIC COMPLAINT & PUBLIC SAFETY SYSTEM ============\n";
    cout << " 1. Register Citizen\n";
    cout << " 2. Register Complaint\n";
    cout << " 3. Update Complaint Status\n";
    cout << " 4. Compare Two Complaints (Priority)\n";
    cout << " 5. View Team Workload (Polymorphism + Operator+ demo)\n";
    cout << " 6. Generate Civic Response Report\n";
    cout << " 7. Display All Citizens\n";
    cout << " 8. Display All Complaints\n";
    cout << " 9. Show Team Supervisors (Virtual Base Class demo)\n";
    cout << " 0. Exit\n";
    cout << "Enter your choice: ";
}
 
int main() {
    CivicComplaintSystem system;
 
    // Seed the system with municipal response teams (heap-allocated, base-class pointers)
    system.addTeam(new SanitationTeam("Sanitation Wing A", 3, 101, "R. Kumar"));
    system.addTeam(new RoadMaintenanceTeam("Road Crew North", 3, 102, "S. Iyer"));
    system.addTeam(new ElectricalTeam("Electrical Unit 1", 2, 103, "P. Raman"));
    system.addTeam(new WaterTeam("Water Works Team", 2, 104, "A. Fernandes"));
    system.addTeam(new PublicSafetyTeam("Public Safety Squad", 4, 105, "N. Das"));
 
    int choice;
    do {
        printMenu();
        if (!(cin >> choice)) { cin.clear(); cin.ignore(1000, '\n'); continue; }
        cin.ignore();
 
        if (choice == 1) {
            string name, contact, address;
            cout << "Enter name: "; getline(cin, name);
            cout << "Enter contact number: "; getline(cin, contact);
            cout << "Enter address: "; getline(cin, address);
            system.registerCitizen(name, contact, address);
        }
        else if (choice == 2) {
            int citId, urgency;
            string type, desc;
            cout << "Enter citizen ID: "; cin >> citId; cin.ignore();
            cout << "Enter complaint type\n"
                 << "  (Pothole/Streetlight/Garbage/Water Leakage/Electrical/Public Safety): ";
            getline(cin, type);
            cout << "Enter description: "; getline(cin, desc);
            cout << "Enter urgency level (1-5): "; cin >> urgency; cin.ignore();
            system.registerComplaint(citId, type, desc, urgency);
        }
        else if (choice == 3) {
            int cId; string st;
            cout << "Enter complaint ID: "; cin >> cId; cin.ignore();
            cout << "Enter new status (Assigned/In Progress/Resolved): "; getline(cin, st);
            system.updateComplaintStatus(cId, st);
        }
        else if (choice == 4) {
            int id1, id2;
            cout << "Enter first complaint ID: "; cin >> id1;
            cout << "Enter second complaint ID: "; cin >> id2;
            system.compareComplaints(id1, id2);
        }
        else if (choice == 5) {
            system.showTeamWorkload();
        }
        else if (choice == 6) {
            system.generateReport();
        }
        else if (choice == 7) {
            system.displayAllCitizens();
        }
        else if (choice == 8) {
            system.displayAllComplaints();
        }
        else if (choice == 9) {
            system.showSupervisors();
        }
        else if (choice == 0) {
            cout << "Exiting Smart Civic Complaint System. Goodbye!\n";
        }
        else {
            cout << "Invalid choice. Please try again.\n";
        }
    } while (choice != 0);
 
    return 0;
}
 
